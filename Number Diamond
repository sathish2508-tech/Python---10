N = int(input())
for i in range(1, N + 1):
    space = " " * (N-i) 
    row = ""
    for j  in range(1, i + 1):
        row = row + str(j) + " "
    value = space + row
    print(value)
for i in range(1, N):
    space = " " * i
    row = ""
    for j in range(1, (N+1) - i):
        row = row + str(j) + " "
    value = space + row
    print(value)
