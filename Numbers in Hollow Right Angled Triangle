N = int(input())
for i in range(1, N + 1):
    if i == 1:
        row = ""
        row += str(1) + " "
        print(row)
    elif i == N:
        row = ""
        for j in range(1, N + 1):
            row += str(j) + " "
        print(row)
    else:
        row = ""
        space = " " * (2*(i)-4)
        row += str(1) + " " + space + str(i) + " "
        print(row)
